// Manifesto do Steam Input.
//
// A Steam usa este arquivo para saber quais ACOES o jogo tem, e entao deixa
// cada pessoa mapear o proprio controle — DualSense, Switch Pro, Steam Deck,
// controle generico — sem que o jogo saiba de nada disso.
//
// Por que ele existe mesmo com o jogo ja tendo bindings de controle no
// project.godot: os bindings do Godot cobrem o controle padrao (XInput). O
// Steam Input cobre TODO o resto, mais remapeamento pelo jogador, mais os
// controles do Steam Deck. Sem o manifesto, o Deck cai no modo mouse-e-teclado
// emulado, que e ruim e aparece na analise de verificacao do Deck.
//
// Onde vai: Steamworks -> Steam Input -> Configuration Settings, e o arquivo
// sobe junto com a build no depot.
"In Game Actions"
{
	"actions"
	{
		"Jogo"
		{
			"title"		"#Set_Jogo"
			"StickPadGyro" {}
			"Button"
			{
				"purga"             "#Action_Purga"
				"turbo"             "#Action_Turbo"
				"comprar_max"       "#Action_ComprarMax"
				"alternar_auto"     "#Action_Auto"
				"pausa"             "#Action_Pausa"
				"salvar"            "#Action_Salvar"
			}
			"AnalogTrigger" {}
		}
		"Paineis"
		{
			"title"		"#Set_Paineis"
			"Button"
			{
				"upgrades"    "#Action_Upgrades"
				"talentos"    "#Action_Talentos"
				"cartas"      "#Action_Cartas"
				"prestigio"   "#Action_Prestigio"
				"conquistas"  "#Action_Conquistas"
				"config"      "#Action_Config"
				"fechar"      "#Action_Fechar"
			}
		}
	}

	"localization"
	{
		"english"
		{
			"Set_Jogo"           "Gameplay"
			"Set_Paineis"        "Panels"
			"Action_Purga"       "Purge"
			"Action_Turbo"       "Fast forward"
			"Action_ComprarMax"  "Buy maximum"
			"Action_Auto"        "Toggle automation"
			"Action_Pausa"       "Pause"
			"Action_Salvar"      "Save now"
			"Action_Upgrades"    "Upgrades"
			"Action_Talentos"    "Talents"
			"Action_Cartas"      "Cards"
			"Action_Prestigio"   "Prestige"
			"Action_Conquistas"  "Achievements"
			"Action_Config"      "Settings"
			"Action_Fechar"      "Close"
		}
		"brazilian"
		{
			"Set_Jogo"           "Jogo"
			"Set_Paineis"        "Paineis"
			"Action_Purga"       "Purga"
			"Action_Turbo"       "Acelerar"
			"Action_ComprarMax"  "Comprar maximo"
			"Action_Auto"        "Ligar/desligar automacao"
			"Action_Pausa"       "Pausar"
			"Action_Salvar"      "Salvar agora"
			"Action_Upgrades"    "Melhorias"
