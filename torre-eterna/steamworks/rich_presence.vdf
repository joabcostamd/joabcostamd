// Presenca rica: o que os amigos veem na lista.
//
// O TEXTO NAO E MANDADO PELO JOGO. O jogo manda so os valores (`onda`,
// `camada`) e a CHAVE `#Status_Jogando`; a Steam monta a frase no idioma de
// QUEM LE. Mandar texto pronto deixaria um brasileiro vendo "Onda 412" na lista
// de amigos de um japones.
//
// Onde vai: Steamworks -> Rich Presence -> Localization.
"lang"
{
	"english"
	{
		"tokens"
		{
			"#Status_Jogando"   "Wave %onda% · %camada%"
			"#Camada_Ascensao"        "Ascension"
			"#Camada_Singularidade"   "Singularity"
			"#Camada_Transcendencia"  "Transcendence"
		}
	}
	"brazilian"
	{
		"tokens"
		{
			"#Status_Jogando"   "Onda %onda% · %camada%"
			"#Camada_Ascensao"        "Ascensao"
			"#Camada_Singularidade"   "Singularidade"
			"#Camada_Transcendencia"  "Transcendencia"
		}
	}
	"schinese"
	{
		"tokens"
		{
			"#Status_Jogando"   "第 %onda% 波 · %camada%"
			"#Camada_Ascensao"        "飞升"
			"#Camada_Singularidade"   "奇点"
			"#Camada_Transcendencia"  "超越"
		}
	}
	"russian"
	{
		"tokens"
		{
			"#Status_Jogando"   "Волна %onda% · %camada%"
			"#Camada_Ascensao"        "Вознесение"
			"#Camada_Singularidade"   "Сингулярность"
			"#Camada_Transcendencia"  "Трансценденция"
		}
	}
}
